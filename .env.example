# ==============================================================================
# GymOS Platform - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure the variables with your production values.
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NextAuth Web Authentication
# ------------------------------------------------------------------------------
# NEXTAUTH_SECRET: High-entropy secret key used to encrypt/sign NextAuth session JWTs.
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-nextauth-secret-key-here"

# NEXTAUTH_URL: Canonical public URL of the web dashboard.
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Mobile App & QR Pass Cryptography
# ------------------------------------------------------------------------------
# JWT_SECRET: Secret key used to sign Mobile Session Tokens and Dynamic 60-second QR Passes (HS256).
# Generate via: openssl rand -base64 32
JWT_SECRET="your-32-character-mobile-jwt-secret-key-here"

# ------------------------------------------------------------------------------
# 4. Logistics Webhook HMAC Verification
# ------------------------------------------------------------------------------
# WEBHOOK_SECRET: Shared secret for verifying HMAC SHA256 signatures from courier delivery APIs (Yalidine, Guepex).
WEBHOOK_SECRET="your-webhook-hmac-secret-key-here"

# ------------------------------------------------------------------------------
# 5. Automated Cron Jobs & Maintenance
# ------------------------------------------------------------------------------
# CRON_SECRET: Bearer authorization token required to invoke /api/cron/daily-checks.
CRON_SECRET="your-cron-bearer-authorization-secret-key-here"

# ------------------------------------------------------------------------------
# 6. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# ALLOWED_ORIGINS: Comma-separated list of allowed origins (production web domain, mobile app bundler).
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8081,https://gymos.dz"
